{
  "name": "user-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clear:port": "kill-port 8081",
    "prestart": "npm run clear:port",
    "start": "expo start --port 8081",
    "prestart:tunnel": "npm run clear:port",
    "start:tunnel": "expo start --tunnel --port 8081",
    "preandroid": "npm run clear:port",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios",
    "ota:production": "npx eas-cli update --channel production --platform android --environment production",
    "build:production:android": "npx eas-cli build --platform android --profile production",
    "preweb": "npm run clear:port",
    "web": "expo start --web --port 8081",
    "web:build": "expo export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/bbh-sans-hegarty": "^0.4.0",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/metro-runtime": "^55.0.9",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.2",
    "@react-navigation/native": "^7.1.31",
    "axios": "^1.13.6",
    "expo": "~55.0.31",
    "expo-constants": "~55.0.14",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-location": "~55.1.14",
    "expo-notifications": "~55.0.27",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.33",
    "nativewind": "^4.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-maps": "^1.26.20",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "0.21.0",
    "react-native-webview": "^13.16.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-safe-area-context",
        "react-native-screens"
      ]
    }
  },
  "private": true
}
