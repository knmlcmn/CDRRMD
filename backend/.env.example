DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
OTP_SECRET=replace-with-another-long-random-secret
CORS_ORIGINS=http://localhost:5173

# Shared cache and distributed rate-limit store. The backend fails open to a
# bounded in-process cache/rate limiter if Redis is temporarily unavailable.
REDIS_URL=redis://localhost:6379
CACHE_PREFIX=cdrrmd:v1
API_RATE_LIMIT=3000
API_RATE_WINDOW_MS=60000

# PostgreSQL pool tuning. Adjust DB_POOL_MAX to the connection allowance of
# the production database (10 is the backend default outside Vercel).
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# SMTP provider settings used by Nodemailer for registration and password-reset OTPs.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=your-address@gmail.com, SMTP_PASS=your-16-character-app-password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=CDRRMD <no-reply@example.com>

# Alternatively, use one provider connection URL instead of SMTP_HOST/PORT/USER/PASS.
# SMTP_URL=smtps://username:password@smtp.example.com:465
