# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cddrmd
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password

# Production PostgreSQL (Neon/Supabase/etc.)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DB_SSL=true

PORT=4000
NODE_ENV=development
# Set to true only for local/default account seeding. Keep false in production.
SEED_DEFAULT_ACCOUNTS=true
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
# Comma-separated production frontend origins
CORS_ORIGINS=https://your-admin.vercel.app,https://your-barangay.vercel.app,https://your-user-web.vercel.app
